; =========================================================
; BALANCED WILD VS GM DOG EVOLUTION SIMULATION
; =========================================================

globals [

  year
  food-available

  gm-10
  gm-25
  gm-50
  gm-75
  gm-100

  wild-10
  wild-25
  wild-50
  wild-75
  wild-100
]

breed [wild-dogs wild-dog]
breed [gm-dogs gm-dog]

turtles-own [
  age
  energy
  strength
]

; =========================================================
; SETUP
; =========================================================

to setup

  clear-all

  set year 0
  set food-available 250

  set gm-10 0
  set gm-25 0
  set gm-50 0
  set gm-75 0
  set gm-100 0

  set wild-10 0
  set wild-25 0
  set wild-50 0
  set wild-75 0
  set wild-100 0

  set-default-shape wild-dogs "wolf"
  set-default-shape gm-dogs "wolf"

  setup-biome
  setup-dogs

  reset-ticks

end

; =========================================================
; BIOME BACKGROUND
; =========================================================

to setup-biome

  if biome = "forest" [
    ask patches [
      set pcolor green
    ]
  ]

  if biome = "mangrove" [
    ask patches [
      set pcolor green - 2
    ]
  ]

  if biome = "savannah" [
    ask patches [
      set pcolor brown
    ]
  ]

end

; =========================================================
; CREATE DOGS
; =========================================================

to setup-dogs

  ; WILD DOGS
  create-wild-dogs initial-wild [

    setxy random-xcor random-ycor

    set shape "wolf"
    set size 1.5

    set age random 13
    set energy 35

    set strength 8

    ; WHITE WILD DOGS
    set color white
  ]

  ; GM DOGS
  create-gm-dogs initial-gm [

    setxy random-xcor random-ycor

    set shape "wolf"
    set size 1.5

    set age random 13
    set energy 40

    set strength 5

    if biome = "forest" [
      set color blue - 4
    ]

    if biome = "mangrove" [
      set color gray
    ]

    if biome = "savannah" [
      set color orange + 2
    ]
  ]

end

; =========================================================
; MAIN LOOP
; =========================================================

to go

  move-dogs
  season-system
  food-system
  reproduction-system
  disease-system
  territorial-system
  aging-system

  if count turtles > 1200 [
    stop
  ]

  tick

  if ticks > 0 and ticks mod 10 = 0 [

    set year year + 1

    record-data
  ]

  if year >= max-years [
    stop
  ]

  wait 0.15

end

; =========================================================
; MOVEMENT
; =========================================================

to move-dogs

  ask turtles [

    rt random 40
    lt random 40

    fd 1.2

    set energy energy - 0.5
  ]

end

; =========================================================
; SEASON SYSTEM
; =========================================================

to season-system

  if season = "winter" [

    ask wild-dogs [
      if random 100 < 6 [
        die
      ]
    ]

    ask gm-dogs [
      if random 100 < 3 [
        die
      ]
    ]
  ]

end

; =========================================================
; FOOD SYSTEM
; =========================================================

to food-system

  if ticks mod 2 = 0 [
    set food-available food-available + 10
  ]

  ask turtles [

    if food-available > 0 [

      set energy energy + 4
      set food-available food-available - 1
    ]
  ]

end

; =========================================================
; REPRODUCTION SYSTEM
; =========================================================

to reproduction-system

  ; WILD DOGS
  ask wild-dogs [

    if random-float 100 < 5 [

      hatch 1 [

        rt random 360
        fd 1

        set age 0
        set energy 20
        set strength 8

        set shape "wolf"

        ; WHITE WILD DOGS
        set color white
      ]
    ]
  ]

  ; GM DOGS
  ask gm-dogs [

    if random-float 100 < 6 [

      hatch 1 [

        rt random 360
        fd 1

        set age 0
        set energy 24
        set strength 5

        set shape "wolf"

        if biome = "forest" [
          set color blue - 4
        ]

        if biome = "mangrove" [
          set color gray
        ]

        if biome = "savannah" [
          set color orange + 2
        ]
      ]
    ]
  ]

end

; =========================================================
; DISEASE SYSTEM
; =========================================================

to disease-system

  ask turtles [

    if random 100 < 3 [
      die
    ]
  ]

end

; =========================================================
; TERRITORIAL SYSTEM
; =========================================================

to territorial-system

  ask wild-dogs [

    let enemy one-of gm-dogs-here

    if enemy != nobody [

      if random 25 < strength [

        ask enemy [
          die
        ]
      ]
    ]
  ]

  ask gm-dogs [

    let enemy one-of wild-dogs-here

    if enemy != nobody [

      if random 25 < strength [

        ask enemy [
          die
        ]
      ]
    ]
  ]

end

; =========================================================
; AGING SYSTEM
; =========================================================

to aging-system

  ask turtles [

    if ticks mod 10 = 0 [
      set age age + 1
    ]

    if age > 13 [
      die
    ]

    if energy <= 0 [
      die
    ]
  ]

end

; =========================================================
; RECORD DATA
; =========================================================

to record-data

  if year = 10 [
    set gm-10 count gm-dogs
    set wild-10 count wild-dogs
  ]

  if year = 25 [
    set gm-25 count gm-dogs
    set wild-25 count wild-dogs
  ]

  if year = 50 [
    set gm-50 count gm-dogs
    set wild-50 count wild-dogs
  ]

  if year = 75 [
    set gm-75 count gm-dogs
    set wild-75 count wild-dogs
  ]

  if year = 100 [
    set gm-100 count gm-dogs
    set wild-100 count wild-dogs
  ]

end
